<% layout("/layout/boilerplate") -%>
    <div class="row offset-2">
        <div class="col-8">
            <h3 class="mt-2">Listing Details:</h3>
        </div>
        <div class="card col-6 show-card">
            <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing image" style="height: 20rem;">
            <p class="card-text">
                <b>
                    <%= listing.title %>
                </b> <br>
                <%= listing.description %> <br>
                    &#8377;<%= listing.price.toLocaleString() %> / night<br>
                        <%= listing.location %> <br>
                            <%= listing.country %>
            </p>
            <div class="btns">
                <a href="/listings/<%=listing.id %>/edit"><button class="btn btn-dark">Edit</button></a>
                <!-- <form action="/listings/<%= listing._id %>/?_method=delete" method="post">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form> -->
                <a href="/listings/<%= listing._id %>?_method=delete"><button type="submit"
                        class="btn btn-danger">Delete</button></a>
            </div>

            <div>
                <h4>Leave a Review</h4>
                <form action="/listings/<%= listing._id %>/reviews" method="post">
                    <div>
                        <label for="rating" class="form-label">Rating:</label>
                        <input type="range" min="1" max="5" class="form-range" name="review[rating]">
                    </div>
                    <div>
                        <label for="msg" class="form-label">comment</label>
                        <textarea name="review[msg]" id="msg" rows="4" cols="20" placeholder="leave a feedback"
                            class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary mt-4">submit review</button>
                </form>
            </div>
        </div>
       <div class="col-8 mt-5">
         <hr>
        <h3>All Reveiws</h3>
        <div class="row">
            <% for (let review of listing.reviews) { %>
                <div class="col-sm-6 mb-3 mb-sm-0">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">John</h5>
                            <p class="card-text">
                                <%=review.msg %> <br>
                                    <%=review.rating %> Stars
                            </p>
                            <form action="/listings/<%= listing._id %>/reviews/<%=review._id %>?_method=DELETE" method="post">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
                <% } %>
        </div>
       </div>

    </div>

