<%- layout("/layout/boilerplate") -%>

    <h1>Edit the listing</h1>
    <form action="/listings/<%= listing.id %>?_method=put" method="post">
        <div>
            <label for="title">Title:</label>
            <input type="text" value="<%= listing.title %>" name="title" id="title">
        </div>
        <div>
            <label for="description">Description:</label>
            <textarea type="text" value="<%= listing.description %>" name="description" id="description"><%= listing.description %> </textarea>
        </div>
        <div>
            <label for="image">image/link:</label>
            <input type="text" value="<%= listing.image %>" name="image" id="image">
        </div>
        <div>
            <label for="price">price:</label>
            <input type="text" value="<%= listing.price %>" name="price" id="price">
        </div>
        <div>
            <label for="location">Location:</label>
            <input type="text" value="<%= listing.location %>" name="location" id="location">
        </div>
        <div>
            <label for="country">Country:</label>
            <input type="text" value="<%= listing.country %>" name="country" id="country">
        </div>
        <button>Save Changes</button>
    </form>
