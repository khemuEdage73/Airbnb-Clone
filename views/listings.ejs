<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    <ul>
        <h1>All listings</h1>
        <a href="/listings/new"><button>Add listing</button></a> 
        <hr>
        <% for (let listing of listings) { %>
           <a href="/listings/<%= listing.id %>"> <li><%= listing.title %> </a></li>
          <%} %>
    </ul>
</body>
</html>