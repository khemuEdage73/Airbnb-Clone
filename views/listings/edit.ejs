<%- layout("/layout/boilerplate") -%>

    <div class="row col-8 offset-2 edit-form">
        <h3 class="mt-2">Edit the listing</h3>
        <form action="/listings/<%= listing.id %>?_method=put" method="post">
            <div>
                <label for="title" class="form-label">Title:</label>
                <input class="form-control" type="text" value="<%= listing.title %>" name="title" id="title">
            </div>
            <div>
                <label for="description" class="form-label">Description:</label>
                <textarea class="form-control" type="text" value="<%= listing.description %>" name="description"
                    id="description"><%= listing.description %> </textarea>
            </div>
            <div>
                <label for="image" class="form-label">image/link:</label>
                <input type="text" class="form-control" value="<%= listing.image %>" name="image" id="image">
            </div>
            <div>
                <label for="price" class="form-label">price:</label>
                <input type="text" class="form-control" value="<%= listing.price %>" name="price" id="price">
            </div>
            <div>
                <label for="location" class="form-label">Location:</label>
                <input type="text" value="<%= listing.location %>" class="form-control col-4" name="location"
                    id="location">
            </div>
            <div>
                <label for="country" class="form-label">Country:</label>
                <input type="text" value="<%= listing.country %>" class="form-control mb-2 col-4" name="country"
                    id="country">
            </div>
            <button class="btn btn-dark mt-3">Save Changes</button>
        </form>
    </div>