<%- layout("/layout/boilerplate") -%>
   
    <h1>All Listings</h1>
  <div class="row row-cols-lg-3 row-cols-sm-1 row-cols-md-2  "> 
     <% for (let listing of listings) { %>
        <a href="/listings/<%=listing.id %>">
        <div class="card col">
            <img src="<%=listing.image %>" class="card-img-top" alt="listing image" style = "height: 20rem;">
            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b><br>
                    <% if(listing.price){ %>
                  &#8377;<%= listing.price.toLocaleString() %> / night
               <% } else { %>
                  Price not available
               <% } %>
            </div>
        </div>
        </a>
        <% } %>
  </div>
 
 
